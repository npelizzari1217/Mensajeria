# Plantilla de variables de entorno — mensajeria (api)
#
# Copiar a `api/.env` y completar. El .env NUNCA se commitea.
# Toda variable nueva se agrega ACA en el mismo commit que la usa
# (regla global de C:\trabajos).
# Los valores de abajo son placeholders, no credenciales reales.

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Base de datos (Prisma) ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/mensajeria

# --- Auth ---
# JWT_SECRET: generar uno propio por entorno. Nunca reutilizar entre dev y prod.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Costo de bcrypt. Subirlo encarece el login a proposito.
BCRYPT_ROUNDS=10

# --- CORS ---
# Origen del front web. El gateway de socket.io tambien lo respeta.
CORS_ORIGIN=http://localhost:5173

# --- Cliente mobile (Expo) ---
# Va en el entorno de `mobile`, no en el de la api.
# El prefijo EXPO_PUBLIC_ hace que Expo lo exponga al bundle: no poner secretos aca.
EXPO_PUBLIC_API_URL=http://localhost:3000
