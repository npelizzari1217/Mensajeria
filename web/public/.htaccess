# =============================================================================
# SPA Fallback para React Router (BrowserRouter con basename="/mensajeria")
# Necesario para que /mensajeria/inbox, /mensajeria/login, etc. no den 404.
# Subir este archivo a: public_html/mensajeria/.htaccess
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /mensajeria/

  # No reescribir archivos o directorios que existen físicamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Todo lo demás → index.html (React Router se encarga del resto)
  RewriteRule . /mensajeria/index.html [L]
</IfModule>

# =============================================================================
# Cache headers
# =============================================================================

<IfModule mod_headers.c>
  # Assets hasheados por Vite (index-Abc123.js) → cache 1 año
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html → nunca cachear (necesita la última versión del bundle)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# =============================================================================
# Seguridad básica
# =============================================================================

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloquear acceso a dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
